{
  "name": "cinebridge",
  "version": "1.0.0",
  "private": true,
  "description": "Microsservico de recomendacao e orquestracao de equipes da plataforma cinebridge",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
